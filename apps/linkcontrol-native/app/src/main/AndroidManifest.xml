<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Foreground service that hosts the MediaProjection screen capture.
         mediaProjection type is mandatory from Android 10+, enforced on 14+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the host enumerate launchable apps WITHOUT the Play-restricted
         QUERY_ALL_PACKAGES. Only apps with a LAUNCHER activity become visible. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Optional: "Display over other apps". Granting it lets the host open a
         requested app even when LinkControl isn't in the foreground (background
         activity-start allowance). Without it, remote app-launch works while the
         LinkControl app is foreground. The user grants this manually. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".LinkControlApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkControl"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.LinkControl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts MediaProjection. Runs in foreground with a permanent, non-dismissible
             notification so a capture session can NEVER be hidden. -->
        <service
            android:name=".webrtc.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Receives remote tap/swipe/navigation commands and dispatches them as
             real gestures. The user must enable this manually in Accessibility
             settings; Android shows its own persistent indicator while it runs. -->
        <service
            android:name=".control.RemoteControlService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_control_service" />
        </service>
    </application>
</manifest>
